generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Scenario {
  id        String   @id @default(cuid())
  title     String
  userId    String?  // Stores the authenticated Supabase user UUID
  data      Json     // Stores complete SimulationInput JSON structure
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scenarios")
}
